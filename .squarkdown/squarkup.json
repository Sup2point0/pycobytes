{
  "$schema": "../.stranger-quarkdown/squarkdown/resources/squarkup-schema.json",

  "repo": "pycobytes",

  "site": "site",
  "sources": [""],
  "exclude": [
    ".stranger-quarkdown/",
    "site/"
  ],
  "dest": "src/routes/",
  "if-no-dir": ["warn", "create"],
  "on-error": "kill",

  "file-name": "~content",
  "bases": "src/parts/bases",
  "page.svelte": "~page.svelte",
  "page.js": "~page.js",
  
  "site-data": "src/data/site.json",
  "styles": "src/styles",
  "page-styles": "src/styles",
  "assets": "assets",
  "site-assets": "assets/site",
  "fonts": [
    "Fira+Mono:wght@400;500;700",
    "Gantari:ital,wght@0,100..900",
    "Geologica:wght@100",
    "Readex+Pro:wght@160..700",
    "Sen:wght@400..800",
    "Source+Sans+Pro:ital,wght@0,200..900;1,200..900"
  ]
}
